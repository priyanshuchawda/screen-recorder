---
import { repository } from "../data/site";
import "../styles/global.css";
interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const includeSoftwareSchema =
  Astro.url.pathname === "/" || Astro.url.pathname === "/download/";
const windowsSoftware = {
  "@type": "SoftwareApplication",
  name: "ScreenRecorder for Windows",
  operatingSystem: "Windows 10, Windows 11",
  applicationCategory: "MultimediaApplication",
  softwareVersion: "0.3.16",
  license: "https://opensource.org/license/mit",
  isAccessibleForFree: true,
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  downloadUrl:
    "https://github.com/priyanshuchawda/screen-recorder/releases/download/v0.3.16/ScreenRecorder-0.3.16-windows-x64.zip",
  url: "https://screenrecording.pages.dev/download/",
  description:
    "Free, open-source screen recorder for Windows 10 and 11 with hardware-first H.264 encoding and local recordings.",
};
const fedoraSoftware = {
  "@type": "SoftwareApplication",
  name: "ScreenRecorder for Fedora",
  operatingSystem: "Fedora Linux 44",
  applicationCategory: "MultimediaApplication",
  softwareVersion: "0.1.5",
  license: "https://opensource.org/license/mit",
  isAccessibleForFree: true,
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  downloadUrl:
    "https://github.com/priyanshuchawda/screen-recorder/releases/download/fedora-v0.1.5/fedora-screen-recorder-0.1.5-1.fc44.x86_64.rpm",
  url: "https://screenrecording.pages.dev/download/",
  description:
    "Free, open-source screen recorder package for Fedora 44 with GNOME and Wayland.",
};
const structuredData =
  Astro.url.pathname === "/"
    ? {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "WebSite",
            name: "ScreenRecorder",
            url: "https://screenrecording.pages.dev/",
          },
          windowsSoftware,
        ],
      }
    : {
        "@context": "https://schema.org",
        "@graph": [windowsSoftware, fedoraSoftware],
      };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b0d11" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="ScreenRecorder" />
    <meta
      property="og:image"
      content="https://screenrecording.pages.dev/social-card.png"
    />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="ScreenRecorder, a free lightweight screen recorder for Windows and Fedora"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta
      name="twitter:image"
      content="https://screenrecording.pages.dev/social-card.png"
    />
    {
      includeSoftwareSchema && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(structuredData)}
        />
      )
    }
    <script>
      document.documentElement.classList.add("has-js");
    </script>
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="brand" href="/" aria-label="ScreenRecorder home"
        ><span class="brand-icon"><span></span></span><span
          >Screen<span class="brand-light">Recorder</span></span
        ></a
      >
      <nav aria-label="Main navigation">
        <a href="/#features">Features</a><a href="/download/">Download</a><a
          href="/docs/">Docs</a
        ><a
          class="github-link"
          href={repository}
          target="_blank"
          rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a
        >
      </nav>
      <button
        type="button"
        class="menu-toggle"
        aria-label="Toggle navigation"
        aria-expanded="false"><span></span><span></span></button
      >
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <a class="brand footer-brand" href="/"
        ><span class="brand-icon"><span></span></span><span
          >Screen<span class="brand-light">Recorder</span></span
        ></a
      >
      <p>Made for recording. Built to stay out of your way.</p>
      <div class="footer-links">
        <a href="/download/">Downloads</a><a href="/docs/">Documentation</a><a
          href={`${repository}/blob/main/LICENSE`}>MIT License</a
        ><a href={repository}>GitHub ↗</a>
      </div>
      <small>© {new Date().getFullYear()} ScreenRecorder contributors</small>
    </footer>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
      const nav = document.querySelector<HTMLElement>(".site-header nav");
      toggle?.addEventListener("click", () => {
        const open = toggle.getAttribute("aria-expanded") === "true";
        toggle.setAttribute("aria-expanded", String(!open));
        nav?.classList.toggle("nav-open", !open);
      });
    </script>
  </body>
</html>
