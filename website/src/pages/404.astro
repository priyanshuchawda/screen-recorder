---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page not found · ScreenRecorder"
  description="This ScreenRecorder page could not be found."
>
  <section class="not-found wrap">
    <span class="error-code">404</span><h1>
      Looks like this<br /><span class="accent-word">take was missed.</span>
    </h1><p>
      That page isn't here. Head back to the homepage or visit the
      documentation.
    </p><div class="hero-actions">
      <a class="button button-primary" href="/">Back to home</a><a
        class="text-link"
        href="/docs/">Browse docs →</a
      >
    </div>
  </section>
</BaseLayout>
